{"response":"<?php\nsession_start();\nrequire_once 'config/db.php';\n\ntry {\n    $count = $pdo->query(\"SELECT COUNT(*) FROM users\")->fetchColumn();\n    if ($count > 0) {\n        header(\"Location: login.php\");\n        exit();\n    }\n} catch (PDOException $e) {\n    $error = \"Connection failed: \" . $e->getMessage();\n}\n\nif ($_SERVER['REQUEST_METHOD'] == 'POST') {\n    $fullname = trim($_POST['fullname']);\n    $username = trim($_POST['username']);\n    $email = trim($_POST['email']);\n    $password = password_hash($_POST['password'], PASSWORD_DEFAULT);\n\n    try {\n        $pdo->beginTransaction();\n        $pdo->exec(\"INSERT IGNORE INTO roles (id, role_name) VALUES (1, 'Super Admin'), (2, 'Manager'), (3, 'Cashier'), (4, 'Waiter')\");\n        $stmt = $pdo->prepare(\"INSERT INTO users (fullname, username, email, password, role_id, status) VALUES (?, ?, ?, ?, 1, 'active')\");\n        $stmt->execute([$fullname, $username, $email, $password]);\n        $pdo->commit();\n        header(\"Location: login.php?setup=success\");\n        exit();\n    } catch (PDOException $e) {\n        $pdo->rollBack();\n        $error = \"System setup failed: \" . $e->getMessage();\n    }\n}\n?>\n<!DOCTYPE html>\n<html lang='en'>\n<head>\n    <meta charset='UTF-8'>\n    <meta name='viewport' content='width=device-width, initial-scale=1.0'>\n    <title>System Setup | Liquor Store RW</title>\n    <link href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet'>\n    <link rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css'>\n    <style>\n        body { background: #1a1a2e; height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Inter', sans-serif; }\n        .setup-card { background: white; padding: 40px; border-radius: 20px; width: 100%; max-width: 450px; box-shadow: 0 15px 40px rgba(0,0,0,0.5); }\n        .btn-primary { background: #e94560; border: none; padding: 12px; font-weight: bold; }\n        .form-label { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #555; }\n    </style>\n</head>\n<body>\n<div class='setup-card'>\n    <div class='text-center mb-4'>\n        <div class='bg-danger d-inline-block p-3 rounded-circle mb-3 text-white'>\n            <i class='fas fa-tools fa-2x'></i>\n        </div>\n        <h4 class='fw-bold text-dark'>System Initialization</h4>\n        <p class='text-muted small'>Register the first Super Admin to begin</p>\n    </div>\n    <?php if(isset($error)): ?>\n        <div class='alert alert-danger py-2 small border-0 text-center'><?= $error ?></div>\n    <?php endif; ?>\n    <form method='POST'>\n        <div class='mb-3'>\n            <label class='form-label'>Full Name</label>\n            <input type='text' name='fullname' class='form-control' placeholder='Enter your full name' required>\n        </div>\n        <div class='mb-3'>\n            <label class='form-label'>Username</label>\n            <input type='text' name='username' class='form-control' placeholder='Login username' required>\n        </div>\n        <div class='mb-3'>\n            <label class='form-label'>Email Address</label>\n            <input type='email' name='email' class='form-control' placeholder='admin@store.rw' required>\n        </div>\n        <div class='mb-4'>\n            <label class='form-label'>Admin Password</label>\n            <input type='password' name='password' class='form-control' placeholder='Minimum 6 characters' required minlength='6'>\n        </div>\n        <button type='submit' class='btn btn-primary w-100'>INITIALIZE SYSTEM</button>\n        <div class='text-center mt-3'>\n            <a href='login.php' class='text-decoration-none small text-muted'>Back to Login</a>\n        </div>\n    </form>\n</div>\n</body>\n</html>"}